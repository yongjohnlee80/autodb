#!/bin/sh
# A FAKE HOST, so the start gate is assertable without a VM.
#
# Every remote action in provision_vm.sh goes through the `ssh` and `scp`
# binaries, so putting these two stubs first on PATH turns the playbook into a
# pure function of its own logic: each remote command is RECORDED, and one of
# them can be made to FAIL. That is the whole seam -- no live host, no sudo, no
# package manager.
#
#   FAKE_LOG          file every remote command is appended to
#   FAKE_HANDOFF_RC   exit status for the --hand-off invocation (default 0)
set -eu

# The remote command is the last argument on both call shapes the playbook
# uses: `ssh $OPTS target cmd` and `ssh -t $OPTS target cmd`.
cmd=""
for a in "$@"; do cmd="$a"; done

printf '%s\n' "$cmd" >> "${FAKE_LOG:?FAKE_LOG must be set}"

# The probe is the one command whose OUTPUT the playbook parses. Everything
# downstream is a decision made from these values, so they are chosen to be a
# host that passes every gate: root, systemd, a package manager, and enough RAM
# that the sizing preflight does not refuse the box.
case "$cmd" in
  *os-release*)
    cat <<'PROBE'
os=debian
osver=12
pretty=Debian GNU/Linux 12 (bookworm)
cpu=2
mem=2048
swap=0
diskfree=20480
arch=x86_64
pkg=apt-get
sudo=yes
systemd=yes
mise=absent
autodb=absent
PROBE
    # THE REMOTE UID, settable: the playbook derives $SUDO from it, and a
    # non-root login is the case where a printed command needs privilege.
    printf 'root=%s\n' "${FAKE_REMOTE_UID:-0}"
    exit 0
    ;;
  *--init*)
    # THE CEREMONY. Failable, because a held ceremony must fail the run and
    # keep the material its recovery command lives in -- a review found this
    # path exiting 0 while deleting that directory.
    exit "${FAKE_INIT_RC:-0}"
    ;;
  *"show -p ActiveState"*)
    # THE UNIT'S STATE OVER TIME, because one reading cannot tell a daemon
    # that stayed up from one that was merely forked.
    #
    # FAKE_ACTIVE_STATES is a comma-separated SEQUENCE, consumed one entry per
    # call and repeating the last: "active,failed" is a unit that goes active
    # and then dies, which a single constant state cannot express -- and that
    # is precisely the case a review found still being accepted.
    #
    # Each entry may carry a pid as state:pid. A crash loop keeps reporting
    # active with a DIFFERENT pid each time, so the pid is how a cell says
    # "active, but not the same process".
    #
    # The cursor lives on disk because every call is a fresh process: this
    # stub is invoked once per sample, not once per run.
    _seq="${FAKE_ACTIVE_STATES:-${FAKE_ACTIVE_STATE:-active}}"
    _cur="${FAKE_LOG}.statecursor"
    _i=0
    [ -r "$_cur" ] && _i="$(cat "$_cur")"
    _n=$(printf '%s' "$_seq" | awk -F, '{print NF}')
    # WRAPS rather than clamping. Clamping made a CONTINUING crash loop
    # unrepresentable: the sequence ran out, the last entry repeated, and the
    # repeated entry then looked perfectly stable -- so the cell passed while
    # the script accepted a loop. Cycling keeps the loop looping.
    _pick=$(( _i % _n + 1 ))
    _entry="$(printf '%s' "$_seq" | cut -d, -f"$_pick")"
    printf '%s' "$(( _i + 1 ))" > "$_cur"
    _st="${_entry%%:*}"
    _pid="4242"
    case "$_entry" in *:*) _pid="${_entry#*:}" ;; esac
    printf '%s\n%s\n%s\n' "$_st" "$_pid" "0"
    exit 0
    ;;
  *"systemctl enable --now autodb-frontdoor"*)
    # A REQUESTED START THAT REFUSES. It used to leave the run reporting
    # success and printing "finish in the TUI" for a daemon that was not up.
    exit "${FAKE_START_RC:-0}"
    ;;
  *--hand-off*)
    # THE INJECTION POINT. A real handoff fails for ordinary reasons: the
    # service account does not exist yet, chown is refused, the uploaded
    # installer is gone.
    exit "${FAKE_HANDOFF_RC:-0}"
    ;;
esac
exit 0
