#!/bin/sh
# "Builds" by writing a binary that reports THE VERSION IT WAS STAMPED WITH.
#
# Taking the version out of -ldflags rather than from the environment is what
# lets a cell distinguish the ref that was built from the ref that was asked
# for: a run that resolved one tag and built another produces a binary that
# says so.
set -eu
printf 'go %s\n' "$*" >> "${UPD_LOG:-/dev/null}"
[ "${1:-}" = "build" ] || exit 0

_out=""
_ver="unstamped"
_prev=""
for _a in "$@"; do
  [ "$_prev" = "-o" ] && _out="$_a"
  case "$_prev" in
    -ldflags) _ver="$(printf '%s\n' "$_a" | sed -n 's/.*-X main\.version=\([^ ]*\).*/\1/p')" ;;
  esac
  _prev="$_a"
done
[ -n "$_out" ] || exit 1
[ -n "$_ver" ] || _ver="unstamped"

# The built binary answers --check-config as well as --version, because the
# updater now pre-flights the configuration before it stops anything and a stub
# that could not answer would exercise only the "cannot check" branch.
#
# UPD_CHECK_RC is the status to return: 0 accepts, 78 is EX_CONFIG (the binary
# read the config and refuses it), and anything else stands for a build that
# does not understand the flag at all.
cat > "$_out" <<INNER
#!/bin/sh
for _arg in "\$@"; do
  # UPD_APPLY_RC / UPD_APPLY_MSG: how --apply-migration-scripts answers — 0
  # applies, 2 with Go's unknown-flag message is a build from before the
  # scripts, anything else a script that failed.
  if [ "\$_arg" = "--apply-migration-scripts" ]; then
    printf 'autodb %s\n' "\$*" >> "${UPD_LOG:-/dev/null}"
    _rc="\${UPD_APPLY_RC:-0}"
    if [ "\$_rc" = "0" ]; then
      # UPD_APPLY_OUT: what a successful apply prints — by default nothing
      # applied; a cell lists scripts to stand for a store it advanced.
      printf '%b\n' "\${UPD_APPLY_OUT:-the schema is up to date (1 scripts applied)}"
    else
      echo "\${UPD_APPLY_MSG:-meta: schema script 000002_update_x.sql, line 3: boom}" >&2
    fi
    exit "\$_rc"
  fi
  # UPD_REVERT_RC: how --revert-migration-script answers (0 reverts).
  if [ "\$_arg" = "--revert-migration-script" ]; then
    printf 'autodb %s\n' "\$*" >> "${UPD_LOG:-/dev/null}"
    _rc="\${UPD_REVERT_RC:-0}"
    [ "\$_rc" = "0" ] && echo "reverted" || echo "meta: revert failed" >&2
    exit "\$_rc"
  fi
  if [ "\$_arg" = "--check-config" ]; then
    _rc="\${UPD_CHECK_RC:-0}"
    if [ "\$_rc" = "0" ]; then
      echo "the configuration would load; nothing was started and nothing was written"
    else
      echo "\${UPD_CHECK_MSG:-autodb: the configuration is invalid}" >&2
    fi
    exit "\$_rc"
  fi
done
echo "autodb $_ver (deadbeef, built 2026-09-09T00:00:00Z)"
INNER
chmod +x "$_out"
exit 0
