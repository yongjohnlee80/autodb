#!/bin/sh
# A UNIT WHOSE STATE IS A SCRIPTED SEQUENCE.
#
# The rollback path can only be reached by a new binary that starts and then
# does NOT stay up, and "does not stay up" is a sequence of states over time --
# so a stub with one constant state cannot reach that path at all, and cannot
# tell a run that accepts the first `active` sample from one that requires
# several.
#
# UPD_STATES is a comma-separated list of `state[:mainpid]`, consumed one entry
# per poll and CYCLING at the end. Cycling rather than clamping: clamping to the
# last entry makes a continuing crash loop unrepresentable, and a poll that
# eventually sees a steady state passes for that reason rather than on merit.
#
# Only the three-property poll advances the cursor. The script also asks for
# ActiveState alone -- once before the swap to learn whether the unit was
# running, once at the end to report -- and letting those consume sequence
# entries would silently shift every cell's timeline.
#
# Every invocation is appended to UPD_LOG, because "did it roll back" and "was
# the unit left alone" are claims about which commands ran.
set -eu
LOG="${UPD_LOG:-/dev/null}"
printf 'systemctl %s\n' "$*" >> "$LOG"

case "${1:-}" in
  show)
    case " $* " in
      *" MainPID "*)
        _seq="${UPD_STATES:-active}"
        _cur="$LOG.cursor"
        _i=0
        [ -r "$_cur" ] && _i="$(cat "$_cur")"
        _n="$(printf '%s' "$_seq" | awk -F, '{print NF}')"
        _entry="$(printf '%s' "$_seq" | cut -d, -f"$(( _i % _n + 1 ))")"
        printf '%s' "$(( _i + 1 ))" > "$_cur"
        _st="${_entry%%:*}"
        _pid=4242
        case "$_entry" in *:*) _pid="${_entry#*:}" ;; esac
        # WHAT REAL systemctl DOES -- both halves of it.
        #
        # `--value` strips the keys; without it each line is KEY=VALUE. And the
        # ORDER IS SYSTEMD'S TO CHOOSE, not the caller's. On the front-door
        # droplet, `-p ActiveState -p MainPID -p NRestarts --value` came back as
        # MainPID, NRestarts, ActiveState -- so a positional reader saw
        # ActiveState=28797 and NRestarts=active, concluded the unit was not
        # active, and rolled back an update that had come up cleanly.
        #
        # This stub used to hardcode the CALLER's order with the comment
        # "mirrors the real ... order", which is precisely the script's own
        # assumption. Verifier and code shared one blind spot, so no cell here
        # could ever have caught the defect. UPD_SHOW_ORDER makes the order a
        # parameter; the default stays the caller's order so existing cells
        # describe the same host they always did.
        _order="${UPD_SHOW_ORDER:-state,pid,restarts}"
        _bare=""
        case " $* " in *" --value "*) _bare="yes" ;; esac
        for _f in $(printf '%s' "$_order" | tr ',' ' '); do
          case "$_f" in
            state)    _k="ActiveState"; _v="$_st" ;;
            pid)      _k="MainPID";     _v="$_pid" ;;
            restarts) _k="NRestarts";   _v="7" ;;
            *) continue ;;
          esac
          if [ "$_bare" = "yes" ]; then
            printf '%s\n' "$_v"
          else
            printf '%s=%s\n' "$_k" "$_v"
          fi
        done
        ;;
      *" ExecMainStatus "*|*" ExecMainCode "*)
        # HOW THE FAILED UNIT EXITED -- AND THEN HOW THE RECOVERED ONE HAS NOT.
        #
        # 78 and 69 send an operator somewhere completely different from a
        # crash, so a stub with one answer cannot tell those branches apart.
        # But ONE INVARIANT ANSWER IS ITS OWN DEFECT, and review found it: with
        # these properties constant for the whole run, a read taken AFTER the
        # rollback restarted the unit returns exactly what a read taken before
        # it would have, so moving the query across the restart is invisible to
        # every cell. The verifier could not distinguish the failure it is
        # about from the recovery that replaced it.
        #
        # So the stub models what the host does. Before the rollback's restart,
        # these describe the new binary's failure. Afterwards the unit is
        # RUNNING the old binary and has not exited under this invocation at
        # all, which real systemd reports as 0/0 -- and the script's own
        # catch-all then says it "did not report how it exited", which is a
        # sentence no semantic cell accepts. A stale read now fails loudly
        # instead of passing silently.
        #
        # The rollback's restart is the SECOND `systemctl start`; the first is
        # the one that launched the binary under test.
        _starts=0
        [ -r "$LOG.starts" ] && _starts="$(cat "$LOG.starts")"
        case " $* " in
          *" ExecMainStatus "*) _k_st="yes" ;;
          *) _k_st="no" ;;
        esac
        if [ "$_starts" -ge 2 ]; then
          printf '%s\n' 0
        elif [ "$_k_st" = "yes" ]; then
          printf '%s\n' "${UPD_EXIT_STATUS:-0}"
        else
          # The siginfo code: 1 is CLD_EXITED, 2 is CLD_KILLED. Defaulting to 1
          # keeps every existing cell describing a unit that exited rather than
          # one that was signalled.
          printf '%s\n' "${UPD_EXIT_CODE:-1}"
        fi
        ;;
      *)
        printf '%s\n' "${UPD_WAS_ACTIVE:-active}"
        ;;
    esac
    ;;
  start)
    # COUNTED, because the exit-status answers above depend on whether the
    # rollback has already put the old binary back.
    _n=0
    [ -r "$LOG.starts" ] && _n="$(cat "$LOG.starts")"
    printf '%s' "$(( _n + 1 ))" > "$LOG.starts"
    ;;
  *) : ;;
esac
exit 0
